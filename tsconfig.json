{
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "es2020",
        "sourceMap": false,
        "rootDir": "app",
        "outDir": "build",
        "types": ["node", "jasmine"],
        "strict": true,
        "noUnusedLocals": true,
        "noUnusedParameters": true,
    },
    "include": [
        "app/index.ts",
        "app/dimensions",
        "app/spec"
    ]
}
